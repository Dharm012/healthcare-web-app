{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend"
    }
  },
  "rewrites": [
    {
      "source": "/api/backend/:match*",
      "destination": "/api/backend/:match*"
    },
    {
      "source": "/:match*",
      "destination": "/frontend/:match*"
    }
  ]
}
